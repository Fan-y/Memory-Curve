{
  "name": "memory-curve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "smoke:workflow": "node scripts/smoke-workflow.mjs",
    "test:ui": "playwright test tests/ui-acceptance.spec.ts --reporter=line --workers=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.59.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-joyride": "^3.1.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.5.5",
    "ts-fsrs": "^5.4.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vitest": "^1.6.1"
  }
}
